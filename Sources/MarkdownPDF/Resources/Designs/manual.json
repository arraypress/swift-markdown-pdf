    { "size": 12.5, "weight": "bold", "colour": "ink", "before": 1.5, "after": 0.45, "numbered": true },
    { "size": 10.5, "weight": "semibold", "colour": "ink", "before": 1.2, "after": 0.35, "numbered": true }
  ],
  "code": { "fill": "wash", "border": true, "size": 8.6, "label": true },
