{
  "name": "memo",
  "description": "A memo: To, From, Date and Re from the front matter, a rule, then the text.",
  "typeface": "sans",
  "page": { "margin": 62, "runningInset": 26 },
  "scale": { "body": 10.5, "leading": 1.45, "paragraphGap": 0.75, "blockGap": 1.0 },
